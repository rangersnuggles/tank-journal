{
  "name": "tank-journal",
  "version": "1.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:dev": "wrangler pages dev .vercel/output/static",
    "pages:deploy": "wrangler pages deploy .vercel/output/static --project-name=tank-journal",
    "db:migrate:local": "wrangler d1 migrations apply tank-journal-db --local",
    "db:seed:local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-local.mjs",
    "db:reset:local": "rm -rf .wrangler/state && npm run db:migrate:local && npm run db:seed:local"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5",
    "wrangler": "^4"
  },
  "dependencies": {
    "next": "^15",
    "posthog-js": "^1.364.2",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.0"
  }
}
